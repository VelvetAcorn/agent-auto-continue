{
  "name": "t3code-auto-continue",
  "version": "2.0.0",
  "description": "Menu-bar helper that schedules a 'Continue' turn for T3 Code, OpenCode, Claude Code and Codex conversations",
  "main": "main.js",
  "author": "T3 Code users",
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "electron-builder --mac zip --publish never",
    "build:dmg": "electron-builder --mac dmg --publish never",
    "build:all": "electron-builder --publish never",
    "test": "node --test",
    "check:syntax": "node tools/check-syntax.cjs",
    "test:electron": "env -u ELECTRON_RUN_AS_NODE ApplePersistenceIgnoreState=YES electron tools/electron-smoke.cjs && node tools/keep-awake-e2e.cjs",
    "icons": "env -u ELECTRON_RUN_AS_NODE ApplePersistenceIgnoreState=YES electron tools/build-icons.cjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "node-schedule": "^2.1.1",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "io.t3code.auto-continue",
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "dashboard.html",
      "styles.css",
      "assets/tray*Template*.png",
      "lib/**/*.js",
      "renderer/**/*.js",
      "package.json"
    ]
  }
}
