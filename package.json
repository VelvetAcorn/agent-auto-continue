{
  "name": "t3code-auto-continue",
  "version": "2.0.0",
  "description": "Menu-bar helper that schedules a 'Continue' turn for T3 Code, OpenCode, Claude Code and Codex conversations",
  "main": "main.js",
  "author": "T3 Code users",
  "license": "MIT",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "electron-builder --mac zip --publish never",
    "build:dmg": "electron-builder --mac dmg --publish never",
    "build:all": "electron-builder --publish never",
    "test": "node --test",
    "check:syntax": "node tools/check-syntax.cjs",
    "test:electron": "env -u ELECTRON_RUN_AS_NODE electron tools/electron-smoke.cjs",
    "icons": "env -u ELECTRON_RUN_AS_NODE electron tools/build-icons.cjs"
  },
  "dependencies": {
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.t3code.auto-continue",
    "icon": "assets/icon.icns",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "ui.html",
      "settings.html",
      "dashboard.html",
      "styles.css",
      "assets/trayTemplate*.png",
      "lib/**/*.js",
      "renderer/**/*.js",
      "package.json"
    ]
  }
}
