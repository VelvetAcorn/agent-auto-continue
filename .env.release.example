# Copy this file to .env.release and fill in the values. .env.release is gitignored.
# Load it with: npm run build:release:local
#
# Apple ID email of the developer account that owns the Developer ID certificate.
APPLE_ID=
# App-specific password from https://account.apple.com (Sign-In and Security, App-Specific Passwords).
# It looks like xxxx-xxxx-xxxx-xxxx. This is not your Apple ID password.
APPLE_APP_SPECIFIC_PASSWORD=
# Ten-character Team ID shown in parentheses in the Developer ID Application certificate name.
# Check with: security find-identity -v -p codesigning
# It can differ from the team of an Apple Development certificate on the same Mac.
APPLE_TEAM_ID=
